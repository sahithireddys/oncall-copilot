  "duration_ms": 34470,
  "hypothesis": {
    "root_cause_service": "shipping",
    "category": "resource_exhaustion",
    "title": "Shipping exhausted HTTP client pool calling quote, causing timeouts",
    "summary": "The shipping service is experiencing client-side timeouts when calling quote due to exhausted connection pool or thread pool resources. Quote itself is healthy (p95 22ms, 0.4% errors, normal CPU/memory), but shipping's calls time out after 2000ms before quote can respond. This causes shipping's p95 latency to spike to 1605ms and error rate to jump to 13.5%. The pattern matches the cart/Redis connection-pool exhaustion incident (PM-2026-03-12).",
    "reasoning": "The alert fired on shipping service latency (p95 > 1s). Shipping's own metrics show a dramatic spike in both latency (40ms \u2192 1605ms) and error rate (0.4% \u2192 13.5%) starting around -10m. The trace evidence is unambiguous: 96% of failing shipping traces end in quote, and quote accounts for 100% of the added latency (+1600ms). The failing trace shows shipping \u2192 quote.Call timing out after 2000ms with \"cURL error 28: Operation timed out\". However, quote's own metrics tell a completely different story: quote's p95 latency remains stable at ~22ms, its error rate is steady at 0.4%, CPU is normal at 8%, and memory is stable at ~25%. Quote is receiving requests (9.2 req/s) and responding normally according to its own telemetry. The timeout is happening on the client side (shipping) before quote can respond. This pattern matches PM-2026-03-12 where cart had Redis connection-pool exhaustion: the dependency (valkey) was healthy but the client (cart) had exhausted its connection pool. Here, shipping is likely exhausting its HTTP client connection pool or thread pool when calling quote, causing requests to queue and timeout before even reaching quote or before quote's response can be processed. The frontend deploy at -12m is a red herring\u2014it's not on the shipping\u2192quote call path and frontend's own metrics are not shown to be degraded. The mechanism is resource_exhaustion in the shipping service's client-side resources for calling quote.",
    "confidence": 0.82,
    "supporting_evidence": [
      {
        "evidence_id": "traces:shipping:8b5cfbe1a821",
        "why_it_matters": "Shows client-side timeout (cURL error 28) in shipping's call to quote after 2000ms, indicating the problem is in shipping's client, not quote's server."
      },
      {
        "evidence_id": "logs:shipping:1",
        "why_it_matters": "826 errors in shipping all report the same client-side timeout calling quote, confirming systematic client-side resource exhaustion."
      },
      {
        "evidence_id": "metrics:quote:p95_latency_ms",
        "why_it_matters": "Quote's own p95 latency remains stable at 22ms, proving quote is responding normally and the timeout is happening before quote can complete."
      },
      {
        "evidence_id": "metrics:quote:error_rate",
        "why_it_matters": "Quote's error rate stays at baseline 0.4%, confirming quote is healthy and not the source of failures."
      },
      {
        "evidence_id": "metrics:shipping:error_rate",
        "why_it_matters": "Shipping's error rate spikes from 0.4% to 13.5% at -10m, marking the onset of the resource exhaustion."
      },
      {
        "evidence_id": "traces:shipping:summary",
        "why_it_matters": "96% of failing traces end in quote with +1600ms latency, but this is client-side delay in shipping, not server-side delay in quote."
      }
    ],
    "suggested_actions": [
      {
        "title": "Check shipping's HTTP client pool configuration and increase if needed",
        "command": "kubectl describe deployment shipping -n otel-demo | grep -A 20 env",
        "risk": "low",
        "rationale": "Inspect shipping deployment for connection pool size, max connections, or thread pool limits. If pool is small (e.g., 8 connections like in PM-2026-03-12), increase it via ConfigMap or env var and restart shipping pods."
      },
      {
        "title": "Restart shipping pods to clear any stuck connections or threads",
        "command": "kubectl rollout restart deployment/shipping -n otel-demo",
        "risk": "low",
        "rationale": "A rolling restart may clear exhausted pools or stuck threads if the pool configuration is already adequate. Monitor if errors drop immediately."
      },
      {
        "title": "Scale shipping horizontally to distribute load across more pods",
        "command": "kubectl scale deployment/shipping --replicas=3 -n otel-demo",
        "risk": "low",
        "rationale": "If each pod has a fixed pool size, adding replicas increases total available connections. This is a temporary mitigation while investigating pool configuration."
      }
    ],
    "related_documents": [
      "PM-2026-03-12",
      "PM-2026-07-09"
    ],
    "alternatives": [
      {
        "root_cause_service": "quote",
        "category": "network_latency",
        "why_less_likely": "Quote's own p95 latency is stable at 22ms and its error rate is normal at 0.4%. If network latency were the issue, we would expect quote's server-side spans to show normal latency while client spans are slow, but quote's metrics show it is responding quickly. The timeouts are happening entirely on the client side in shipping."
      }
    ],
    "reasoner": "claude:claude-sonnet-4-5"
  },
