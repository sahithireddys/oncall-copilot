  "retrieved_documents": [
    {
      "id": "PM-2026-07-09",
      "title": "Shipping failed after a quote address change",
      "type": "postmortem",
      "services": [
        "shipping",
        "quote",
        "checkout"
      ],
      "category": "config_change",
      "date": "2026-07-09",
      "snippet": "## Summary A Helm values change renamed the quote service address. Shipping could not resolve `quote-svc` and 90% of checkouts failed at the shipping step with `dns error`. ## Root cause Configuration change on shipping (QUOTE_ADDR). Quote itself was healthy and idle. ## Resolution Reverted the env var and redeployed shipping. ## Lessons - `no such host` / `dns error` in a caller plus an idle call\u2026",
      "score": 39.116
    },
    {
      "id": "PM-2026-03-12",
      "title": "Cart checkout failures from Redis connection-pool exhaustion",
      "type": "postmortem",
      "services": [
        "cart",
        "valkey-cart",
        "frontend"
      ],
      "category": "resource_exhaustion",
      "date": "2026-03-12",
      "snippet": "## Summary For 47 minutes, 18% of add-to-cart and checkout requests failed with `RedisTimeoutException ... pool busy=8/8`. The cart service's Redis client pool had been reduced to 8 connections in a refactor (PR #2231). Valkey itself was healthy (CPU 9%, p99 2ms). Frontend alerted on 5xx ratio. ## Detection FrontendHighErrorRate fired first. The on-call initially suspected Valkey because of a pod \u2026",
      "score": 26.275
    },
    {
      "id": "PM-2026-05-04",
      "title": "Recommendation OOM loop from an unbounded product cache",
      "type": "postmortem",
      "services": [
        "recommendation",
        "frontend"
      ],
      "category": "memory_leak",
      "date": "2026-05-04",
      "snippet": "## Summary Recommendation was OOMKilled every ~7 minutes for two hours. Each restart dropped in-flight requests, so frontend saw periodic bursts of 5xx. Memory grew linearly from ~45% to 100% of the limit between restarts (sawtooth). ## Root cause An in-process cache keyed by product-id list had no eviction. The `recommendationCacheFailure` flag reproduces this. ## Resolution Restarted the deploym\u2026",
      "score": 18.043
    },
    {
      "id": "PM-2026-01-20",
      "title": "Payment 1.7.3 release failed card charges with a TypeError",
      "type": "postmortem",
      "services": [
        "payment",
        "checkout"
      ],
