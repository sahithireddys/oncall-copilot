# --- reasoning -------------------------------------------------------------
# claude = Anthropic API (needs ANTHROPIC_API_KEY); heuristic = offline rule-based baseline
REASONER=claude
ANTHROPIC_API_KEY=
# Use the latest Sonnet model you have access to
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- telemetry -------------------------------------------------------------
# simulated = replay scenario telemetry (no cluster needed); live = real cluster
TELEMETRY_MODE=simulated
K8S_NAMESPACE=otel-demo
# Defaults assume: kubectl -n otel-demo port-forward svc/frontend-proxy 8080:8080
# plus port-forwards for Prometheus (9090) and OpenSearch (9200)
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:8080/jaeger/ui
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=otel-logs-*
GRAFANA_URL=http://localhost:8080/grafana

# --- notifications -----------------------------------------------------------
SLACK_WEBHOOK_URL=
PUBLIC_UI_URL=http://localhost:5173

# --- misc ------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_DRILLDOWN_ROUNDS=2
INVESTIGATION_WINDOW_MINUTES=45
